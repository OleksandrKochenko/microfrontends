{
  "name": "react-mf-navbar",
  "author": "dbiershov",
  "license": "ISC",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src",
    "start": "webpack serve --port 9100",
    "start:standalone": "webpack serve --env standalone",
    "test": "jest --passWithNoTests",
    "build": "pnpm run type-check && webpack --mode=production",
    "build:tar": "tar -czvf ./react-mf-navbar.tar.gz ./package.json -C dist ./react-mf-navbar.js ./react-mf-navbar.js.map",
    "analyze": "webpack --mode=production --env analyze",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "watch-tests": "jest --watch",
    "coverage": "jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "copy-webpack-plugin": "7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^6.26.2",
    "react-router-dom": "^6.26.2",
    "single-spa-react": "^6.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/plugin-proposal-class-properties": "^7.10.1",
    "@babel/plugin-proposal-decorators": "^7.12.12",
    "babel-jest": "^29.7.0",
    "babel-loader": "^8.4.1",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.3.1",
    "typescript": "^5.8.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^4.10.0",
    "webpack-config-single-spa-react": "7.0.0",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.10.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && concurrently pnpm:test pnpm:lint"
    }
  },
  "packageManager": "pnpm@9.11.0"
}
